  <node
    pkg="avoidance_rerouting"
    exec="vision_detection"
    name="vision_detection_node"
    output="screen">
    <param name="camera_index" value="0"/>
    <param name="camera_url" value="http://host.docker.internal:5555/"/>
    <param name="detection_rate" value="5.0"/>
    <param name="text_prompt" value="iphone."/>
  </node>

  <node
    pkg="avoidance_rerouting"
    exec="routing_simulation"
    name="routing_simulation"
    output="screen">
    <param name="use_test_obstacles" value="false"/>
  </node>

  <node
    pkg="foxglove_bridge"
    exec="foxglove_bridge"
    name="foxglove_bridge"
    output="screen">
    <param name="port" value="8765"/>
  </node>

  <include file="$(find-pkg-share laser_segmentation)/launch/segmentation.launch.py">
    <arg name="log_level" value="info"/>
  </include>

</launch>
